# Copy to .dev.vars for local development. Never commit .dev.vars.
#
# In production these are set with `wrangler secret put <NAME>` instead.

# Signs session cookies. Generate with:  openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-32-random-bytes"

# Cloudflare API token with Images:Edit on your account.
# Photo uploads fail without it; everything else works.
CF_API_TOKEN=""

# Social sign-in. Leave blank to hide the buttons — email sign-in still works.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Sign in with Apple. Required before the iOS app can be submitted, because
# App Store guideline 4.8 demands it alongside any other social login.
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Web Push (VAPID). Leave blank to keep push off — the app runs fine without it
# and every send becomes a no-op. Generate a pair with:
#   node scripts/generate-vapid-keys.mjs
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:safety@spruetube.app"

# Launch curtain — a "coming soon" holding page in front of the whole site.
# Leave COMING_SOON blank to keep it off. Set it to "true" to draw the curtain;
# then open any URL with ?preview=<COMING_SOON_BYPASS> to get behind it. Set the
# bypass token BEFORE turning the curtain on, or you lock yourself out too.
COMING_SOON=""
COMING_SOON_BYPASS=""

# Local dev overrides. These shadow the vars in wrangler.jsonc so that auth
# origins, links and the sitemap all point at the dev server rather than at
# the live domain.
ENVIRONMENT="development"
SITE_URL="http://localhost:5173"
