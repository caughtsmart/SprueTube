{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spruetube",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },

  // Decays Discover scores so posts nobody touches fall down the page.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },

  // spruetube.app is canonical. www is attached here too and redirected to the
  // apex by a Redirect Rule at the edge — see docs/DEPLOY.md step 6.
  "routes": [
    { "pattern": "spruetube.app", "custom_domain": true },
    { "pattern": "www.spruetube.app", "custom_domain": true }
  ],

  // Created in the WEUR region — the audience is UK and European, and D1 reads
  // are served from wherever the primary lives.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spruetube",
      "database_id": "d15396fa-e98d-46c5-9212-1c38dbbb1c2f",
      "migrations_dir": "migrations"
    }
  ],

  "kv_namespaces": [
    {
      // Rate limiting counters, feed caches, ephemeral upload tokens.
      "binding": "CACHE",
      "id": "6f09e2419a8f44c5a5114fa204cac13c"
    }
  ],

  // No R2 binding yet, deliberately. Photos live in Cloudflare Images, so
  // nothing in the codebase reads a bucket — and an unused binding pointing at
  // a bucket that does not exist fails the deploy. Add it back (bucket
  // "spruetube-media", binding "MEDIA") when there is a reason to, e.g. keeping
  // untouched originals or serving data exports.

  "vars": {
    "SITE_URL": "https://spruetube.app",
    "SITE_NAME": "SprueTube",
    // Loaded Dice storefront used for the "paints used" affiliate links.
    "SHOP_URL": "https://www.loadeddice.uk",
    "SHOP_NAME": "Loaded Dice",
    // Needed for the Cloudflare Images REST API. From `wrangler whoami`.
    "CF_ACCOUNT_ID": "REPLACE_WITH_ACCOUNT_ID",
    // Public account hash from Images → the imagedelivery.net URL prefix.
    // Uploads work without it; the feed cannot build image URLs.
    "CF_IMAGES_ACCOUNT_HASH": "MTceR3C16CyQmjHH6ME2VA",
    // Envelope sender for password resets and email confirmation. The domain
    // has to be verified in Resend or every message is rejected outright.
    "EMAIL_FROM": "SprueTube <noreply@spruetube.app>",
    // Leave empty until AdSense approves the site; ad slots render house ads.
    "ADSENSE_CLIENT": "",
    "ENVIRONMENT": "production"
  }

  // Secrets (set with `wrangler secret put <NAME>`):
  //   BETTER_AUTH_SECRET        — 32+ random bytes, signs sessions
  //   CF_API_TOKEN              — Cloudflare Images edit permission
  //   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
  //   APPLE_CLIENT_ID / APPLE_CLIENT_SECRET  (needed before iOS submission)
}
