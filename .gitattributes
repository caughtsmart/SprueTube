# Normalise line endings in the repository to LF.
* text=auto eol=lf

# Shell scripts especially. Checked out with CRLF — which git on Windows will
# do by default — the shebang line ends `/usr/bin/env bash\r`, and bash then
# reports "No such file or directory". It is talking about the interpreter, not
# the script, but the message is identical to the one you get when the file
# genuinely is not there, which makes it a miserable thing to debug.
*.sh text eol=lf
*.mjs text eol=lf

# Leave binaries alone.
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
